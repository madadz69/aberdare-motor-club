---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout
	title="Events | Aberdare Motor Club"
	description="Upcoming Aberdare Motor Club events."
>
	<section class="events-hero" aria-labelledby="events-heading">
		<img
			class="events-hero-image"
			src={withBase('images/events/mk2-escort-forest.webp')}
			alt="Classic Mk2 Escort rally car sliding sideways on a wet forest stage"
			width="1774"
			height="887"
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
		<div class="container events-hero-inner">
			<p class="eyebrow">Club calendar</p>
			<h1 id="events-heading">Upcoming events</h1>
			<p class="intro">
				Keep up with the latest Aberdare Motor Club meetings, competitions and social events
				across South Wales.
			</p>
		</div>
	</section>

	<section class="events-calendar" aria-labelledby="calendar-heading">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-12 col-lg-11 col-xl-10">
					<div class="calendar-heading text-center">
						<h2 id="calendar-heading">Event calendar</h2>
					</div>
					<iframe
						class="calendar-embed"
						src="https://calendar.google.com/calendar/embed?src=d8e3135ebd4db2559f9fce9c4f7d8d675daee9385acd715c183d51d3a32a8d8b%40group.calendar.google.com&ctz=Europe%2FLondon&mode=AGENDA"
						title="Aberdare Motor Club event calendar"
						width="800"
						height="600"
						loading="lazy"
					></iframe>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.events-hero {
		position: relative;
		display: grid;
		min-height: clamp(25rem, 48vw, 34rem);
		overflow: hidden;
		background: #0b1220;
		color: #ffffff;
	}

	.events-hero::before {
		position: absolute;
		z-index: 1;
		inset: 0;
		background: linear-gradient(
			90deg,
			rgba(3, 7, 18, 0.92) 0%,
			rgba(3, 7, 18, 0.76) 38%,
			rgba(3, 7, 18, 0.22) 72%,
			rgba(3, 7, 18, 0.38) 100%
		);
		content: '';
	}

	.events-hero-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.events-hero-inner {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-block: clamp(4rem, 9vw, 7rem);
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		color: #fca5a5;
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 46rem;
		margin: 0;
		font-size: clamp(2.5rem, 7vw, 4.75rem);
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1;
		text-wrap: balance;
	}

	.intro {
		max-width: 42rem;
		margin: 1.25rem 0 0;
		color: #d1d5db;
		font-size: clamp(1rem, 2vw, 1.2rem);
		line-height: 1.7;
		text-wrap: pretty;
	}

	.events-calendar {
		padding-block: clamp(3rem, 6vw, 5rem);
		background: #f3f4f6;
		color: #1f2937;
	}

	.events-calendar h2 {
		margin: 0 0 0.75rem;
		color: #111827;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 750;
		letter-spacing: -0.025em;
	}

	.events-calendar p {
		margin: 0;
		color: #4b5563;
		font-size: 1.05rem;
	}

	.calendar-embed {
		display: block;
		width: 100%;
		height: clamp(37.5rem, 58vw, 43rem);
		margin-top: 2rem;
		border: 0;
		border-radius: 0.75rem;
		background: #ffffff;
		box-shadow: 0 0.5rem 1.5rem rgba(17, 24, 39, 0.1);
	}

	@media (max-width: 47.99rem) {
		.events-hero::before {
			background: rgba(3, 7, 18, 0.68);
		}

		.events-hero-image {
			object-position: 62% center;
		}

		.calendar-embed {
			height: 37.5rem;
		}
	}
</style>
