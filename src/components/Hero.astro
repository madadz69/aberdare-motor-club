---
import { withBase } from '../utils/paths';

interface Props {
	title?: string;
}

const {
	title = 'Welcome to\nAberdare Motor Club',
} = Astro.props;

const slides = [
	{
		src: withBase('images/events/mk2-escort-forest.webp'),
		alt: 'Classic Mk2 Escort on a forest rally stage',
		position: '65% center',
	},
	{
		src: withBase('images/hero/autotest.jpg'),
		alt: 'Competition car navigating an autotest course in a Welsh valley',
		position: '65% center',
	},
	{
		src: withBase('images/hero/forest-rally.jpg'),
		alt: 'Classic rally car competing on a gravel forestry stage',
		position: '65% center',
	},
];
---

<section
	class="hero"
	data-carousel
	role="region"
	aria-label="Aberdare Motor Club highlights"
	aria-roledescription="carousel"
>
	<div class="slides">
		{slides.map((slide, index) => (
			<div
				class="slide"
				data-slide
				data-active={index === 0 ? 'true' : undefined}
				aria-hidden={index === 0 ? 'false' : 'true'}
			>
				<img
					src={slide.src}
					alt={slide.alt}
					style={`--object-position: ${slide.position}`}
					loading={index === 0 ? 'eager' : 'lazy'}
					fetchpriority={index === 0 ? 'high' : 'auto'}
					decoding="async"
				/>
			</div>
		))}
	</div>

	<div class="hero-shade" aria-hidden="true"></div>

	<div class="container hero-content">
    <p class="hero-eyebrow">South Wales · Established 1958</p>
    <h1>{title}</h1>
    <p class="hero-intro">A shared interest in cars. A warm welcome.<br class="desktop-break" /> Join us for club nights, social events, motoring and motorsport.</p>
    <div class="hero-actions">
      <a class="action" href={withBase('join/')}>Join the club <span aria-hidden="true">→</span></a>
      <a class="action action-outline" href={withBase('events/')}>Explore events</a>
    </div>
    <p class="hero-footnote">Motoring. Motorsport. Good company.</p>
  </div>

	<button class="arrow arrow-previous" type="button" data-previous aria-label="Previous image">
		<span aria-hidden="true">&#8249;</span>
	</button>
	<button class="arrow arrow-next" type="button" data-next aria-label="Next image">
		<span aria-hidden="true">&#8250;</span>
	</button>

	<div class="carousel-controls">
		<div class="indicators" role="group" aria-label="Choose an image">
			{slides.map((_, index) => (
				<button
					class="indicator"
					type="button"
					data-slide-to={index}
					aria-label={`Show image ${index + 1} of ${slides.length}`}
					aria-current={index === 0 ? 'true' : 'false'}
				></button>
			))}
		</div>

		<button
			class="pause-toggle"
			type="button"
			data-pause
			aria-pressed="false"
		>
			<span data-pause-icon aria-hidden="true">Ⅱ</span>
			<span class="visually-hidden" data-pause-label>Pause slideshow</span>
		</button>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
		const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-slide]'));
		const indicators = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-slide-to]'));
		const previous = carousel.querySelector<HTMLButtonElement>('[data-previous]');
		const next = carousel.querySelector<HTMLButtonElement>('[data-next]');
		const pause = carousel.querySelector<HTMLButtonElement>('[data-pause]');
		const pauseIcon = carousel.querySelector<HTMLElement>('[data-pause-icon]');
		const pauseLabel = carousel.querySelector<HTMLElement>('[data-pause-label]');
		const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');

		let currentSlide = 0;
		let timer: number | undefined;
		let manuallyPaused = false;

		const stopTimer = () => {
			if (timer !== undefined) window.clearInterval(timer);
			timer = undefined;
		};

		const showSlide = (newIndex: number) => {
			currentSlide = (newIndex + slides.length) % slides.length;

			slides.forEach((slide, index) => {
				const active = index === currentSlide;
				slide.dataset.active = String(active);
				slide.setAttribute('aria-hidden', String(!active));
			});

			indicators.forEach((indicator, index) => {
				indicator.setAttribute('aria-current', String(index === currentSlide));
			});
		};

		const startTimer = () => {
			stopTimer();
			if (
				manuallyPaused ||
				motionPreference.matches ||
				document.hidden ||
				carousel.matches(':hover') ||
				carousel.matches(':focus-within') ||
				slides.length < 2
			) return;

			timer = window.setInterval(() => showSlide(currentSlide + 1), 6500);
		};

		const moveToSlide = (newIndex: number) => {
			showSlide(newIndex);
			startTimer();
		};

		previous?.addEventListener('click', () => moveToSlide(currentSlide - 1));
		next?.addEventListener('click', () => moveToSlide(currentSlide + 1));

		indicators.forEach((indicator, index) => {
			indicator.addEventListener('click', () => moveToSlide(index));
		});

		pause?.addEventListener('click', () => {
			manuallyPaused = !manuallyPaused;
			pause.setAttribute('aria-pressed', String(manuallyPaused));
			if (pauseIcon) pauseIcon.textContent = manuallyPaused ? '▶' : 'Ⅱ';
			if (pauseLabel) pauseLabel.textContent = manuallyPaused ? 'Play slideshow' : 'Pause slideshow';
			manuallyPaused ? stopTimer() : startTimer();
		});

		carousel.addEventListener('mouseenter', stopTimer);
		carousel.addEventListener('mouseleave', startTimer);
		carousel.addEventListener('focusin', stopTimer);
		carousel.addEventListener('focusout', () => window.setTimeout(startTimer));
		document.addEventListener('visibilitychange', startTimer);
		motionPreference.addEventListener('change', startTimer);

		showSlide(0);
		startTimer();
	});
</script>

<style>
  .hero { position: relative; display: grid; align-items: center; min-height: 580px; overflow: hidden; isolation: isolate; background: var(--ink); color: var(--paper); }
  .slides, .slide, .slide img, .hero-shade { position: absolute; inset: 0; }
  .slides { z-index: -2; left: 23%; }
  .slide { opacity: 0; transition: opacity 900ms ease; }
  .slide[data-active='true'] { opacity: 1; }
  .slide img { width: 100%; height: 100%; object-fit: cover; object-position: var(--object-position, center); }
  .hero-shade { z-index: -1; background: linear-gradient(90deg, #111719 10%, rgba(17,23,25,.94) 29%, rgba(17,23,25,.36) 60%, rgba(17,23,25,.08)), linear-gradient(0deg, #111719 0%, transparent 27%); }
  .hero-content { padding-block: 4rem 5rem; }
  .hero-eyebrow { margin-bottom: 1.75rem; color: var(--gold); font-family: var(--display); font-size: .85rem; letter-spacing: .22em; text-transform: uppercase; }
  h1 { max-width: 680px; white-space: pre-line; margin: 0 0 1.5rem; font-size: clamp(3.5rem, 6vw, 5.3rem); font-weight: 400; letter-spacing: .015em; line-height: 1.02; }
  .hero-intro { max-width: 32rem; font-size: 1.05rem; color: #e0e0da; line-height: 1.7; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.6rem; }
  .hero-footnote { margin: 2rem 0 0; color: #b8bab6; font-size: .7rem; letter-spacing: .18em; text-transform: uppercase; }
  .arrow, .pause-toggle, .indicator { border: 1px solid #727571; background: rgba(17,23,25,.7); color: white; cursor: pointer; }
  .arrow { position: absolute; bottom: 1.7rem; width: 44px; height: 44px; font-size: 1.8rem; line-height: 1; }
  .arrow-previous { right: 5rem; } .arrow-next { right: 1.7rem; }
  .arrow:hover, .pause-toggle:hover { background: var(--red); }
  .carousel-controls { position: absolute; right: 9rem; bottom: 1.7rem; display: flex; align-items: center; gap: 1rem; }
  .indicators { display: flex; }
  .indicator { width: 32px; height: 44px; border: 0; background: transparent; position: relative; }
  .indicator::after { content: ''; position: absolute; height: 3px; left: 5px; right: 5px; top: 20px; background: #737570; }
  .indicator[aria-current='true']::after { background: var(--gold); }
  .pause-toggle { width: 44px; height: 44px; }
  @media (max-width: 767px) {
    .hero { min-height: 650px; align-items: end; }
    .slides { left: 0; bottom: 30%; }
    .hero-shade { background: linear-gradient(0deg, #111719 12%, rgba(17,23,25,.93) 38%, rgba(17,23,25,.08) 100%); }
    .hero-content { padding-block: 10rem 6rem; }
    h1 { font-size: clamp(3rem, 11vw, 4.7rem); }
    .hero-eyebrow { margin-bottom: 1rem; font-size: .75rem; }
    .hero-intro { font-size: .95rem; } .desktop-break { display: none; }
    .hero-footnote { display: none; }
    .hero-actions { gap: .6rem; } .action { padding-inline: 1rem; font-size: .85rem; }
  }
</style>
