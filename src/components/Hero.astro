---
interface Props {
	title?: string;
}

const {
	title = 'Welcome to Aberdare Motor Club',
} = Astro.props;

const slides = [
	{
		src: '/images/hero/rally-tarmac.jpg',
		alt: 'Rally car competing on a wet tarmac stage in the Welsh hills',
		position: '38% center',
	},
	{
		src: '/images/hero/autotest.jpg',
		alt: 'Competition car navigating an autotest course in a Welsh valley',
		position: '38% center',
	},
	{
		src: '/images/hero/forest-rally.jpg',
		alt: 'Classic rally car competing on a gravel forestry stage',
		position: '38% center',
	},
];
---

<section
	class="hero"
	data-carousel
	role="region"
	aria-label="Aberdare Motor Club highlights"
	aria-roledescription="carousel"
>
	<div class="slides">
		{slides.map((slide, index) => (
			<div
				class="slide"
				data-slide
				data-active={index === 0 ? 'true' : undefined}
				aria-hidden={index === 0 ? 'false' : 'true'}
			>
				<img
					src={slide.src}
					alt={slide.alt}
					style={`--object-position: ${slide.position}`}
					loading={index === 0 ? 'eager' : 'lazy'}
					fetchpriority={index === 0 ? 'high' : 'auto'}
					decoding="async"
				/>
			</div>
		))}
	</div>

	<div class="hero-shade" aria-hidden="true"></div>

	<div class="hero-content">
		<img
			class="hero-logo"
			src="/images/motorclub-logo.png"
			alt=""
			width="400"
			height="400"
			loading="eager"
			decoding="async"
		/>
		<h1>{title}</h1>
		<div class="hero-actions">
			<a class="button button-primary" href="/contact">Join the club</a>
			<a class="button button-secondary" href="/events">View events</a>
		</div>
	</div>

	<button class="arrow arrow-previous" type="button" data-previous aria-label="Previous image">
		<span aria-hidden="true">&#8249;</span>
	</button>
	<button class="arrow arrow-next" type="button" data-next aria-label="Next image">
		<span aria-hidden="true">&#8250;</span>
	</button>

	<div class="carousel-controls">
		<div class="indicators" role="group" aria-label="Choose an image">
			{slides.map((_, index) => (
				<button
					class="indicator"
					type="button"
					data-slide-to={index}
					aria-label={`Show image ${index + 1} of ${slides.length}`}
					aria-current={index === 0 ? 'true' : 'false'}
				></button>
			))}
		</div>

		<button
			class="pause-toggle"
			type="button"
			data-pause
			aria-pressed="false"
		>
			<span data-pause-icon aria-hidden="true">Ⅱ</span>
			<span class="visually-hidden" data-pause-label>Pause slideshow</span>
		</button>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
		const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-slide]'));
		const indicators = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-slide-to]'));
		const previous = carousel.querySelector<HTMLButtonElement>('[data-previous]');
		const next = carousel.querySelector<HTMLButtonElement>('[data-next]');
		const pause = carousel.querySelector<HTMLButtonElement>('[data-pause]');
		const pauseIcon = carousel.querySelector<HTMLElement>('[data-pause-icon]');
		const pauseLabel = carousel.querySelector<HTMLElement>('[data-pause-label]');
		const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');

		let currentSlide = 0;
		let timer: number | undefined;
		let manuallyPaused = false;

		const stopTimer = () => {
			if (timer !== undefined) window.clearInterval(timer);
			timer = undefined;
		};

		const showSlide = (newIndex: number) => {
			currentSlide = (newIndex + slides.length) % slides.length;

			slides.forEach((slide, index) => {
				const active = index === currentSlide;
				slide.dataset.active = String(active);
				slide.setAttribute('aria-hidden', String(!active));
			});

			indicators.forEach((indicator, index) => {
				indicator.setAttribute('aria-current', String(index === currentSlide));
			});
		};

		const startTimer = () => {
			stopTimer();
			if (
				manuallyPaused ||
				motionPreference.matches ||
				document.hidden ||
				carousel.matches(':hover') ||
				carousel.matches(':focus-within') ||
				slides.length < 2
			) return;

			timer = window.setInterval(() => showSlide(currentSlide + 1), 6500);
		};

		const moveToSlide = (newIndex: number) => {
			showSlide(newIndex);
			startTimer();
		};

		previous?.addEventListener('click', () => moveToSlide(currentSlide - 1));
		next?.addEventListener('click', () => moveToSlide(currentSlide + 1));

		indicators.forEach((indicator, index) => {
			indicator.addEventListener('click', () => moveToSlide(index));
		});

		pause?.addEventListener('click', () => {
			manuallyPaused = !manuallyPaused;
			pause.setAttribute('aria-pressed', String(manuallyPaused));
			if (pauseIcon) pauseIcon.textContent = manuallyPaused ? '▶' : 'Ⅱ';
			if (pauseLabel) pauseLabel.textContent = manuallyPaused ? 'Play slideshow' : 'Pause slideshow';
			manuallyPaused ? stopTimer() : startTimer();
		});

		carousel.addEventListener('mouseenter', stopTimer);
		carousel.addEventListener('mouseleave', startTimer);
		carousel.addEventListener('focusin', stopTimer);
		carousel.addEventListener('focusout', () => window.setTimeout(startTimer));
		document.addEventListener('visibilitychange', startTimer);
		motionPreference.addEventListener('change', startTimer);

		showSlide(0);
		startTimer();
	});
</script>

<style>
	.hero {
		position: relative;
		flex: 1;
		width: 100vw;
		width: 100dvw;
		margin-inline: calc(50% - 50vw);
		margin-inline: calc(50% - 50dvw);
		display: grid;
		min-height: clamp(32rem, 70vh, 44rem);
		place-items: center;
		overflow: hidden;
		isolation: isolate;
		background: #111827;
		color: #ffffff;
	}

	.slides,
	.slide,
	.slide img,
	.hero-shade {
		position: absolute;
		inset: 0;
	}

	.slides {
		z-index: -2;
	}

	.slide {
		opacity: 0;
		transition: opacity 900ms ease;
	}

	.slide[data-active='true'] {
		opacity: 1;
	}

	.slide img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--object-position, center);
	}

	.hero-shade {
		z-index: -1;
		background:
			linear-gradient(90deg, rgba(3, 7, 18, 0.55), rgba(3, 7, 18, 0.15), rgba(3, 7, 18, 0.55)),
			linear-gradient(0deg, rgba(3, 7, 18, 0.72), rgba(3, 7, 18, 0.1) 65%);
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: min(70rem, calc(100% - 9rem));
		text-align: center;
		text-shadow: 0 2px 18px rgba(0, 0, 0, 0.55);
	}

	.hero-logo {
		display: block;
		width: clamp(8rem, 13vw, 11rem);
		height: auto;
		margin-top: 1.25rem;
		filter: drop-shadow(0 0.4rem 0.65rem rgba(0, 0, 0, 0.4));
	}

	h1 {
		max-width: 70rem;
		margin: 0 auto;
		color: #d1d5db;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(1.85rem, 3.8vw, 3.25rem);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.15;
		text-wrap: balance;
	}

	.hero-actions {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3rem;
		border: 2px solid transparent;
		border-radius: 0.35rem;
		padding: 0.75rem 1.2rem;
		font-weight: 800;
		text-decoration: none;
		text-shadow: none;
		transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
	}

	.button:hover,
	.button:focus-visible {
		transform: translateY(-2px);
	}

	.button-primary {
		background: #315fa8;
		color: #ffffff;
	}

	.button-primary:hover,
	.button-primary:focus-visible {
		background: #244b8f;
	}

	.button-secondary {
		border-color: rgba(255, 255, 255, 0.8);
		background: rgba(17, 24, 39, 0.55);
		color: #ffffff;
		backdrop-filter: blur(4px);
	}

	.button-secondary:hover,
	.button-secondary:focus-visible {
		background: #ffffff;
		color: #111827;
	}

	.arrow,
	.pause-toggle,
	.indicator {
		border: 0;
		color: #ffffff;
		cursor: pointer;
	}

	.arrow {
		position: absolute;
		top: 50%;
		display: grid;
		width: 3rem;
		height: 3rem;
		place-items: center;
		border: 1px solid rgba(255, 255, 255, 0.4);
		border-radius: 50%;
		background: rgba(17, 24, 39, 0.58);
		font-size: 2.25rem;
		line-height: 1;
		transform: translateY(-50%);
		backdrop-filter: blur(4px);
	}

	.arrow:hover,
	.arrow:focus-visible,
	.pause-toggle:hover,
	.pause-toggle:focus-visible {
		background: #315fa8;
	}

	.arrow-previous {
		left: 1.5rem;
	}

	.arrow-next {
		right: 1.5rem;
	}

	.carousel-controls {
		position: absolute;
		bottom: 1.5rem;
		left: 50%;
		display: flex;
		align-items: center;
		gap: 0.85rem;
		transform: translateX(-50%);
	}

	.indicators {
		display: flex;
		align-items: center;
		gap: 0.55rem;
	}

	.indicator {
		width: 0.7rem;
		height: 0.7rem;
		border: 2px solid #ffffff;
		border-radius: 50%;
		padding: 0;
		background: transparent;
	}

	.indicator[aria-current='true'] {
		background: #ffffff;
	}

	.pause-toggle {
		display: grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		border-radius: 50%;
		background: rgba(17, 24, 39, 0.7);
		font-size: 0.75rem;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 47.99rem) {
		.hero {
			min-height: 34rem;
		}

		.hero-content {
			width: calc(100% - 2rem);
		}

		.hero-logo {
			width: 7.5rem;
		}

		.arrow {
			top: auto;
			bottom: 0.9rem;
			width: 2.75rem;
			height: 2.75rem;
			transform: none;
		}

		.arrow-previous {
			left: 0.5rem;
		}

		.arrow-next {
			right: 0.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.slide,
		.button {
			transition: none;
		}
	}
</style>
