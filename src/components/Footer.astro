---
import "@fortawesome/fontawesome-free/css/all.min.css";
import { withBase } from '../utils/paths';
import ClubRecognition from './ClubRecognition.astro';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="row g-4 g-lg-5">
      <div class="col-12 col-md-5">
        <div class="row g-3 align-items-center">
          <div class="col-auto">
            <a class="footer-brand" href={withBase()} aria-label="Aberdare Motor Club home">
              <img
                src={withBase('images/motorclub-logo.png')}
                alt=""
                width="400"
                height="400"
                loading="lazy"
                decoding="async"
              />
            </a>
          </div>
          <div class="col footer-brand-copy">
            <p class="tagline">Motoring, motorsport and good company in South Wales.</p>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-4">
        <h2 class="footer-heading">Contact us</h2>
        <p class="footer-copy">
          Want to join, come to a club night or find out more?
        </p>
        <a class="footer-link" href={withBase('contact/')}>
          Get in touch <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="col-12 col-md-3">
        <h2 class="footer-heading">Follow the club</h2>
        <nav class="social-links" aria-label="Social media">
          <a
            class="social-link"
            href="https://www.facebook.com/OfficialAberdareMC"
            aria-label="Aberdare Motor Club on Facebook"
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
          </a>
        </nav>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-content">
      <p>&copy; {currentYear} Aberdare Motor Club. All rights reserved.</p>
      <p class="design-credit">
        <span class="design-credit-label">Website designed and developed by</span>
        <span class="design-credit-name">JenkoWeb</span>
      </p>
      <div class="footer-recognition"><ClubRecognition /></div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid #343a3a;
    background: var(--ink);
    color: #d1d5db;
  }

  .footer-main {
    padding-block: 2.5rem;
  }

  .footer-brand {
    display: inline-block;
    color: #ffffff;
    text-decoration: none;
  }

  .footer-brand img {
    display: block;
    width: 6.5rem;
    height: 6.5rem;
    object-fit: contain;
    filter: drop-shadow(0 0.3rem 0.45rem rgba(0, 0, 0, 0.3));
  }

  .tagline {
    margin: 0;
  }

  .footer-heading {
    margin: 0 0 0.75rem;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
  }

  .footer-recognition {
    justify-self: end;
    width: 100%;
    max-width: 10rem;
  }

  .footer-copy {
    max-width: 22rem;
    margin: 0 0 0.75rem;
    line-height: 1.6;
  }

  .footer-link,
  .footer-brand:hover,
  .footer-brand:focus-visible {
    color: var(--gold);
  }

  .footer-link {
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: #ffffff;
  }

  .footer-bottom {
    border-top: 1px solid #293345;
    padding-block: 1.25rem;
    color: #9ca3af;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem 2rem;
  }

  .footer-bottom .design-credit {
    text-align: center;
  }

  .design-credit-label {
    display: block;
    margin-bottom: 0.2rem;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .design-credit-name {
    color: #e5e7eb;
    font-weight: 600;
  }

  .design-credit-copyright {
    display: inline-block;
    margin-left: 0.75rem;
    padding-left: 0.75rem;
    border-left: 1px solid #374151;
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .footer-bottom-content {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .footer-bottom .design-credit {
      width: 100%;
      padding-top: 1rem;
      border-top: 1px solid #293345;
    }

    .footer-recognition {
      justify-self: center;
    }
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .social-link {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0;
    background: transparent; border: 1px solid #55584f;
    color: white;
    font-size: 1.25rem;
    text-decoration: none;
    transition: background 180ms ease, transform 180ms ease;
  }

  .social-link:hover,
  .social-link:focus-visible {
    background: #dc2626;
    color: #ffffff;
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .social-link {
      transition: none;
    }
  }
</style>
