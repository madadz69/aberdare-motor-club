---
import { withBase } from '../utils/paths';
---
<aside class="meeting-strip" aria-label="Club meeting details">
  <div class="container meeting-inner">
    <p class="meeting-label"><i class="fa-regular fa-calendar" aria-hidden="true"></i> Club nights</p>
    <p><i class="fa-solid fa-location-dot" aria-hidden="true"></i> The Ynyscynon Inn <span>Aberdare</span></p>
    <p><i class="fa-regular fa-clock" aria-hidden="true"></i> Second Monday of the month · 7pm</p>
    <a href={withBase('contact/')}>Come and meet us <span aria-hidden="true">↗</span></a>
  </div>
</aside>
<section class="about-intro" id="about" aria-labelledby="about-heading">
  <div class="container about-layout">
    <div class="about-copy">
      <p class="section-label">Our club</p>
      <h2 id="about-heading">An interest in cars.<br />A club to share it.</h2>
      <p>Aberdare Motor Club is a <a class="recognition-link" href="https://motorsportuk.org/clubs-organisers/find-clubs/">Motorsport UK recognised club</a>, bringing together people with an interest in motoring and motorsport. Come along to a club night, meet fellow enthusiasts and find out what’s happening.</p>
      <p>Club life includes social outings, quizzes and getting together, as well as competing and helping at events. If you’d like to try motorsport, members can offer advice on driving, co-driving, crewing or marshalling. If you’re here for the cars and the company, you’re welcome too.</p>
      <a class="action" href={withBase('join/')}>Find your place <span aria-hidden="true">→</span></a>
    </div>
    <div class="club-collage">
      <figure class="photo photo-main">
        <img src={withBase('images/hero/autotest.jpg')} alt="A competition car on an autotest course in a Welsh valley" width="1920" height="1080" loading="lazy" />
        <figcaption>South Wales. Our home ground.</figcaption>
      </figure>
      <figure class="photo photo-small">
        <img src={withBase('images/hero/forest-rally.jpg')} alt="Classic rally car tackling a gravel forestry stage" width="1920" height="1080" loading="lazy" />
        <figcaption>See you at the next stage.</figcaption>
      </figure>
      <span class="since">Bringing enthusiasts<br />together since <strong>1958</strong></span>
    </div>
  </div>
</section>
<style>
  .meeting-strip { background: var(--ink); color: var(--paper); border-block: 1px solid #33383a; }
  .meeting-inner { display: flex; align-items: stretch; }
  .meeting-inner p, .meeting-inner a { display: flex; align-items: center; gap: .8rem; margin: 0; padding: 1.2rem 1.7rem; border-right: 1px solid #33383a; font-family: var(--display); text-transform: uppercase; letter-spacing: .08em; font-size: .82rem; }
  .meeting-inner p:first-child { padding-left: 0; color: var(--gold); }
  .meeting-inner i { color: var(--gold); }
  .meeting-inner p span { color: var(--muted); }
  .meeting-inner a { margin-left: auto; border: 0; padding-right: 0; color: var(--gold); text-decoration: none; }
  .meeting-inner a:hover { color: white; }
  .about-intro { scroll-margin-top: 6rem; padding-block: 5rem; background: var(--paper); overflow: hidden; }
  .recognition-link { color: var(--ink); font-weight: 650; text-decoration-color: #11171940; text-underline-offset: .2em; }
  .recognition-link:hover { color: var(--red-dark); text-decoration-color: currentColor; }
  .about-layout { display: grid; grid-template-columns: 1fr 1.15fr; gap: 5rem; align-items: center; }
  h2 { margin: 0 0 1.5rem; font-size: clamp(2.4rem, 3.8vw, 3.7rem); line-height: 1.05; font-weight: 400; letter-spacing: .02em; }
  .about-copy > p:not(.section-label) { max-width: 34rem; color: #444847; font-size: .96rem; line-height: 1.75; }
  .action { margin-top: .5rem; }
  .club-collage { position: relative; min-height: 360px; }
  .photo { margin: 0; background: #faf7f0; padding: .6rem .6rem 0; box-shadow: 0 12px 25px #11171926; }
  .photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  figcaption { padding: .7rem .3rem; font-family: var(--display); font-size: .7rem; letter-spacing: .13em; text-transform: uppercase; }
  .photo-main { width: 80%; transform: rotate(-4deg); }
  .photo-main img { height: 250px; }
  .photo-small { position: absolute; width: 55%; right: 0; top: 175px; transform: rotate(6deg); }
  .photo-small img { height: 155px; }
  .since { display: block; margin: 1.5rem 0 0 1rem; font-family: var(--display); text-transform: uppercase; font-size: .85rem; letter-spacing: .07em; line-height: 1.5; }
  .since strong { color: var(--red); font-weight: 400; }
  @media (max-width: 1100px) { .meeting-inner p, .meeting-inner a { padding-inline: 1rem; font-size: .7rem; } .meeting-inner p span { display: none; } .about-layout { gap: 3rem; } }
  @media (max-width: 767px) {
    .meeting-inner { display: grid; grid-template-columns: 1fr 1fr; padding-block: .5rem; }
    .meeting-inner p, .meeting-inner a { border: 0; margin: 0; padding: .6rem 0; font-size: .68rem; gap: .5rem; }
    .meeting-inner p:nth-child(2) { grid-column: 1 / -1; grid-row: 2; }
    .meeting-inner p:nth-child(3) { grid-column: 1 / -1; grid-row: 3; }
    .meeting-inner a { grid-column: 2; grid-row: 1; justify-content: end; }
    .about-intro { padding-block: 3rem; } .about-layout { grid-template-columns: 1fr; gap: 2.5rem; }
    .club-collage { min-height: 340px; } .photo-main img { height: 210px; } .photo-small { top: 145px; } .photo-small img { height: 135px; }
  }
</style>
